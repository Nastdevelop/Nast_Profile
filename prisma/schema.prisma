generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  password String
  name     String?

  project  Project[]
  skill    Skill[]
  sessions Session[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id       Int    @id @default(autoincrement())
  title    String
  images   String?
  desc     String?
  tech     String  @default("[]")
  posisi   String @default("fullstack")
  url      String?

  authorId Int
  author   User   @relation(fields: [authorId], references: [id])
}

model Skill {
  id       Int    @id @default(autoincrement())
  item     String @unique
  cate     String
  purpose  String

  authorId Int
  author   User   @relation(fields: [authorId], references: [id])
}

model Experience {
  id      Int    @id @default(autoincrement())
  jenis   String
  content String
  tahun   String
}
